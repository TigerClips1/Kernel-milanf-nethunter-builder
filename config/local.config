# =============================================================================
# local.config - device variables for Moto G Stylus 5G (2022) "milanf"
# =============================================================================
# This file is ONLY read by Kali's optional build-script collection
# (kali-nethunter-kernel-builder, "build.sh").  The supported way to build
# this device is:
#
#       ./build-nethunter-kernel.sh
#
# which does a proper LineageOS-style config merge (see README).  If you do use
# the Kali builder, remember that it expects a standalone defconfig in
# arch/arm64/configs/ - this device does NOT work that way, you must merge:
#
#   vendor/holi-qgki_defconfig
#   vendor/ext_config/lineage_moto-holi.config
#   vendor/ext_config/moto-holi-milanf.config
#   config/nethunter_milanf.fragment
#
# with scripts/kconfig/merge_config.sh and point the builder's CONFIG= at the
# resulting file.  Building config/nethunter_milanf.fragment as a defconfig
# produces a kernel that does not boot.
# =============================================================================

# Architecture
export ARCH=arm64
export SUBARCH=arm64

# Kernel source
# KDIR is set by build.sh to the kernel source root

# Do NOT export LOCALVERSION here.  LOCALVERSION is pinned inside the config
# fragment (CONFIG_LOCALVERSION) so it can be matched byte-for-byte against the
# release string the ROM's prebuilt vendor modules were built for.  An extra
# LOCALVERSION here would be appended on top and break module loading.

# Merged config (create it with: ./build-nethunter-kernel.sh config, then copy
# out/.config to arch/arm64/configs/ if you really want to use the builder)
CONFIG=nethunter_milanf_defconfig

# Target kernel image (stock LineageOS 23.2 builds an uncompressed Image)
IMAGE_NAME=Image

# This device loads its device tree from the boot image (BOARD_INCLUDE_DTB_IN_BOOTIMG),
# and the DTB is preserved by AnyKernel3 - nothing to rebuild here.
DO_DTB=false
DO_DTBO=false
DTB_VER=2
DTB_FILES=""

# Modules: the ROM's modules live in vendor_boot.img.  The NetHunter fragment
# only enables built-in (=y) features, so no module has to be shipped with the
# boot image (anykernel.sh sets do.modules=0).
MODULE_DIRTREE=""

# Threads
THREADS="$(nproc)"

# Toolchain: AOSP clang only (the device tree sets TARGET_KERNEL_NO_GCC := true).
# GCC is not required; CROSS_COMPILE is just the GNU triple used by kbuild.
export CLANG_ROOT="${PROJECT_DIR:-$PWD}/toolchains/clang-r563880c"
export CLANG_PATH="${CLANG_ROOT}/bin"
export PATH="${CLANG_PATH}:${PATH}"
export LD_LIBRARY_PATH="${CLANG_ROOT}/lib64:${LD_LIBRARY_PATH:-}"
export CLANG_TRIPLE=aarch64-linux-gnu-
export CROSS_COMPILE=aarch64-linux-gnu-
export CROSS_COMPILE_ARM32=arm-linux-gnueabi-
export LLVM_IAS=1
CC=clang
