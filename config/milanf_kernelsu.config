# KernelSU Next integration for the Motorola milanf QGKI 5.4.302 tree.
# This is a GKI/QGKI build, so the supported flow is the standard KernelSU-Next
# integration used in the upstream setup script, not the legacy non-GKI kprobe
# path. The upstream setup adds the KernelSU driver and enables CONFIG_KSU=y.
CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set
# CONFIG_KSU_DISABLE_MANAGER is not set
# CONFIG_KSU_DISABLE_POLICY is not set
# CONFIG_KSU_X86_PATCH_SYSCALL_DISPATCHER is not set
# This QGKI kernel has CONFIG_KPROBES=y, so KSU_MANUAL_HOOK's Kconfig default
# ("y if !KPROBES") silently falls back to KSU_KPROBES_HOOK. Only manual hook
# is compatible with this repo's 5.4 patches (patches/kernelsu/0002, 0003), so
# force it explicitly instead of relying on the Kconfig default.
CONFIG_KSU_MANUAL_HOOK=y
# CONFIG_KSU_KPROBES_HOOK is not set
# CONFIG_KSU_SYSCALL_TABLE_HOOK is not set
