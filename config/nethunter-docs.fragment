# =============================================================================
#  Kali NetHunter - "docs parity" fragment      (PATH B ONLY)
# =============================================================================
#  Everything the official NetHunter kernel-configuration chapters ask for
#  that the ROM's own config chain (holi-qgki_defconfig + the two
#  moto-holi-*.config files) does not already provide.
#
#  Why Path B only: almost all of it loads *new* sub-systems (DVB/SDR, extra
#  mac80211 drivers, ipc/vsock namespaces).  genksyms derives symbol CRCs from
#  the type tables of each translation unit, so a wide struct change rehashes
#  CRCs and the ROM's prebuilt /vendor modules stop loading.  In Path B we
#  ship the complete module set in the vendor_boot ramdisk and first-stage
#  init loads it, so no ROM module is ever loaded and rehashing is harmless.
#
#  Reference: https://www.kali.org/docs/nethunter/
#    nethunter-kernel-2-config-1   General      (SYSVIPC, modules)
#    nethunter-kernel-3-config-2   Network      (BT, mac80211, USB ethernet)
#    nethunter-kernel-4-config-3   Wifi         (external USB adapters)
#    nethunter-kernel-5-config-4   SDR          (DVB / SDR sticks)
#    nethunter-kernel-7-config-6   4.x USB      (USB gadget functions)
#    nethunter-kernel-9-config-8   CAN          (CARsenal)
#    nethunter-kernel-8-config-7   NFS          (already satisfied)
#
#  Merge order (see do_config):
#    base defconfig -> ROM fragments -> nethunter_milanf.fragment
#                    -> pathb.fragment -> THIS FILE -> localversion.fragment
#
#  Already satisfied by the ROM config / main fragment (nothing to do here):
#    MODULES, MODULE_UNLOAD, MODVERSIONS, ANDROID_BINDER_IPC, BT_HCIBTUSB
#    (+_BCM/_RTL), BT_HCIUART(+_H4/_BCM/_3WIRE/_LL/_QCA), BT_HCIBCM203X,
#    BT_HCIBPA10X, BT_RFCOMM, WLAN_VENDOR_ATH/RALINK/REALTEK/MEDIATEK,
#    ATH9K_HTC, RT2X00(+RT2800USB and all rt33/35/3573/53/55/unknown),
#    RTL8187, RTL_CARDS, RTL8192CU, RTL8XXXU(+_UNTESTED), MT76x0U, MT76x2U,
#    USB_RTL8150, USB_RTL8152, USB_ACM, USB_CONFIGFS_SERIAL/_ACM/_NCM/_ECM/
#    _ECM_SUBSET/_RNDIS/_MASS_STORAGE/_F_HID, USB_MON, NFS_V2/V3/V4, NFSD,
#    NFSD_V3/V4, CAN(+RAW/BCM/GW/VCAN/SLCAN/DEV/CALC_BITTIMING + the USB
#    adapters), USB_SERIAL(+GENERIC/CH341/FTDI_SIO), INET_DIAG
#  Not available in this 5.4 tree (no symbol to set):
#    NET_SCH_CAN, CAN_ISOTP + CAN_HLCAN (out-of-tree clones in the docs),
#    BUILD_ARM64_APPENDED_DTB_IMAGE (device uses uncompressed Image + DTB)
# =============================================================================

# --- General -----------------------------------------------------------------
# Metasploit's PostgreSQL creates its shared-memory segments and semaphores
# through SysV IPC; without this the Kali services fail to start.
CONFIG_SYSVIPC=y
# docs: "Forced module unloading" - lets us rmmod a stuck driver.
# NOTE: never rmmod sgm4154x_charger on this device, it reboots instantly.
CONFIG_MODULE_FORCE_UNLOAD=y

# --- Network: mac80211 -------------------------------------------------------
# WEXT shim: needed by iwconfig / aircrack-ng / wifite WEXT code paths and by
# hostapd's older WEXT driver (EvilTwin).
CONFIG_CFG80211_WEXT=y
# docs: "Enable mac80211 mesh networking (pre-802.11s) support" - mesh attacks
# (wpa_supplicant mesh mode, "MESH" tools).
CONFIG_MAC80211_MESH=y

# --- Network: socket diagnostics ---------------------------------------------
# docs (CAN chapter, "Networking options"): "NETLINK: socket monitoring
# interface" and "Virtual Socket protocol".
CONFIG_NETLINK_DIAG=y
CONFIG_VSOCKETS=y

# --- Network: Bluetooth dongles (BT Arsenal) ---------------------------------
# BT Arsenal drives external adapters: Sena UD100 (CSR BC04), TP-Link UB500
# (RTL8761BU), generic CSR 4.0.  The USB ones are covered by BT_HCIBTUSB
# (+_RTL) which the ROM already enables; these add the remaining transports.
CONFIG_BT_HCIBFUSB=y                  # HCI BlueFRITZ! USB
CONFIG_BT_HCIVHCI=y                   # virtual HCI device (btvirt/testing)
CONFIG_BT_HCIUART_INTEL=y             # Intel UART controllers
CONFIG_BT_HCIUART_ATH3K=y             # Atheros UART firmware download
CONFIG_BT_HCIUART_MRVL=y              # Marvell UART
# NOT possible: CONFIG_BT_HCIUART_RTL (the docs' "Realtek protocol support")
#   depends on ACPI + BT_HCIUART_SERDEV + GPIOLIB - arm64 Android has no ACPI.
#   Realtek USB dongles (TP-Link UB500) are covered by BT_HCIBTUSB_RTL=y below.
CONFIG_BT_ATH3K=y                     # Atheros USB firmware download
CONFIG_BT_MRVL=y                      # Marvell Bluetooth (incl. dongles)
CONFIG_BT_BNEP=y                      # Bluetooth PAN/bnep (blueman, pan attacks)

# --- Wifi: remaining documented USB adapters (Wi-Fi injection) ---------------
# The docs' "Wifi injection = Yes" means: custom kernel + a supported external
# adapter.  These are the documented ones still missing from the ROM config.
# (NOTE: the *internal* qcacld-3.0 driver in this Motorola tree has no
#  gEnableMonitorMode plumbing, so built-in monitor/injection would need a
#  driver patch - external adapters are the supported path.)
CONFIG_CARL9170=y                     # Atheros AR9170 (Linux community)
CONFIG_ATH6KL=y
CONFIG_ATH6KL_USB=y                   # Atheros ath6kl USB
CONFIG_MT7601U=y                      # MediaTek MT7601U (very common stick)
CONFIG_RT2500USB=y                    # Ralink rt2500
CONFIG_RT73USB=y                      # Ralink rt73
CONFIG_WLAN_VENDOR_ZYDAS=y
CONFIG_USB_ZD1201=y
CONFIG_ZD1211RW=y                     # ZyDAS ZD1211/1211B
CONFIG_USB_NET_RNDIS_WLAN=y           # "Wireless RNDIS USB support"

# --- SDR (RTL-SDR, HackRF, Airspy) -------------------------------------------
# docs: Media support -> "Digital TV support" + "Software defined radio
# support", then Media USB adapters AirSpy / HackRF / Mirics MSi2500.
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=y
CONFIG_MEDIA_SDR_SUPPORT=y
CONFIG_DVB_CORE=y
# RC_CORE is a dependency of the (older) dvb-usb v1 core.
CONFIG_RC_CORE=y
CONFIG_DVB_USB=y
CONFIG_DVB_USB_V2=y
CONFIG_USB_AIRSPY=y
CONFIG_USB_HACKRF=y
CONFIG_USB_MSI2500=y
# The docs say to *clear* MEDIA_SUBDRV_AUTOSELECT and then hand-pick frontends.
# We keep it ON on purpose: with autoselect off, every tuner/frontend in the
# tree defaults to =m (that is the "unselect all" the docs ask for by hand) and
# ~100 unused driver modules would be built for nothing.  Autoselect reaches the
# exact same capability for the RTL-SDR by pulling in the frontends/tuners that
# DVB_USB_RTL28XXU declares, and we still pin the important ones explicitly
# below so nothing depends on a default.
CONFIG_MEDIA_SUBDRV_AUTOSELECT=y
CONFIG_DVB_RTL2830=y
CONFIG_DVB_RTL2832=y
CONFIG_DVB_RTL2832_SDR=y              # RTL-SDR (the documented dongle)
CONFIG_DVB_SI2168=y
CONFIG_DVB_ZD1301_DEMOD=y
# The RTL2832U *USB bridge* - without this there is no /dev/dvb or /dev/swradio
# device and neither rtl_test nor RF Analyzer can see the stick.
CONFIG_DVB_USB_RTL28XXU=y
# RTL-SDR tuners: the R820T/R820T2 is in practically every RTL2832U stick sold
# as an "RTL-SDR", the others cover the older/rarer dongles.
CONFIG_MEDIA_TUNER_R820T=y
CONFIG_MEDIA_TUNER_E4000=y
CONFIG_MEDIA_TUNER_FC0012=y
CONFIG_MEDIA_TUNER_FC0013=y
CONFIG_MEDIA_TUNER_FC2580=y
CONFIG_MEDIA_TUNER_MT2060=y

# --- USB gadget: remaining USB-Arsenal modes ---------------------------------
CONFIG_USB_CONFIGFS_OBEX=y            # CDC OBEX
CONFIG_USB_CONFIGFS_EEM=y             # Ethernet Emulation Model
CONFIG_USB_SERIAL_CONSOLE=y           # USB serial console

# --- CAN: remaining documented (optional) drivers ----------------------------
# CARsenal: vcan/slcan/rx+tx are already in.  These are the "optionally you
# may also" entries plus the two the docs list that were still off.
# The docs' "Enable LED triggers for Netlink based drivers" (CONFIG_CAN_LEDS)
# now depends on CONFIG_BROKEN upstream; the driver's own Kconfig says the
# netdev trigger does everything it did, so we enable that instead.
CONFIG_LEDS_TRIGGER_NETDEV=y
CONFIG_CAN_8DEV_USB=y                 # 8devices USB2CAN
CONFIG_CAN_GRCAN=y                    # Aeroflex Gaisler GRCAN (documented)
CONFIG_CAN_M_CAN=y                    # Bosch M_CAN core (needed by _PLATFORM)
CONFIG_CAN_M_CAN_PLATFORM=y           # Bosch M_CAN (documented)
CONFIG_CAN_SOFTING=y                  # Softing GmbH generic (documented)
CONFIG_CAN_HI311X=y                   # Holt HI311x SPI CAN (documented)
CONFIG_CAN_MCP251X=y                  # Microchip MCP251x SPI CAN (docs; the "MCP25XX CAN module" CARsenal cable)
CONFIG_CAN_XILINXCAN=y                # Xilinx CAN (documented)
# NOT possible in this tree - Motorola pruned the controller cores, so the
# documented platform drivers cannot be selected at all:
#   CONFIG_CAN_CC770_PLATFORM  (needs CAN_CC770      - not in tree)
#   CONFIG_CAN_C_CAN_PLATFORM  (needs CAN_C_CAN      - not in tree)
#   CONFIG_CAN_SJA1000_PLATFORM(needs CAN_SJA1000    - not in tree)
# None of them is usable on a phone anyway (no platform CAN controller);
# CARsenal's real cables (Seeed/CANable/8dev/ELM327/MCP25xx) are USB, and the
# USB drivers plus slcan/GS_USB/MCP251X above cover every one of them.
