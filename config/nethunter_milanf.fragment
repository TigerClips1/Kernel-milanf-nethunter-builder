# =============================================================================
# Kali NetHunter kernel config FRAGMENT - Moto G Stylus 5G (2022) "milanf"
# =============================================================================
# Device : Motorola Moto G Stylus 5G (2022) XT2215-1/-3/-4 - SM6375 (holi)
# ROM    : LineageOS 23.2 (Android 16), kernel 5.4.302
# Compiler: Android clang r563880c (clang 21) + lld + LLVM integrated as
#
# >>> THIS IS A KCONFIG FRAGMENT, NOT A DEFCONFIG <<<
#
# A fragment is merged ON TOP of a full base config. Running it as a standalone
# defconfig (e.g. "make nethunter_milanf_defconfig") throws away every
# LineageOS / device option that is not listed here - display, touchscreen,
# charger, fingerprint, CONFIG_MILANF_DTB, CONFIG_SM_GCC_HOLI, ... - and the
# resulting kernel will not boot.
#
# The merge chain MUST match LineageOS (device/motorola/sm6375-common +
# device/motorola/milanf BoardConfig.mk):
#
#   1. arch/arm64/configs/vendor/holi-qgki_defconfig                 (base)
#   2. arch/arm64/configs/vendor/ext_config/lineage_moto-holi.config (LineageOS)
#   3. arch/arm64/configs/vendor/ext_config/moto-holi-milanf.config  (milanf)
#   4. config/nethunter_milanf.fragment                              (this file)
#
# ../build-nethunter-kernel.sh does this with scripts/kconfig/merge_config.sh
# and then reports any symbol below that Kconfig silently dropped.
#
# RULES FOR THIS FILE
#   * Add only options that differ from the stock LineageOS 23.2 kernel.
#   * Never change an option that alters the in-memory layout of a structure
#     used by a prebuilt ROM module. The ROM's modules live in vendor_boot.img
#     and are NOT replaced by an AnyKernel zip; a layout change alters symbol
#     CRCs and a release-string change alters vermagic - either way the module
#     refuses to load and the device loses Wi-Fi / touch / charging.
# =============================================================================


# =============================================================================
# 1. Kernel release string - CRITICAL, read this
# =============================================================================
# The ROM's vendor modules carry vermagic
#     5.4.302-<localversion> SMP preempt mod_unload modversions aarch64
# and CONFIG_MODVERSIONS=y makes the kernel refuse a module whose vermagic does
# not match exactly.
#
# Read off the device on 2026-09-19 (LineageOS 23.2, built 2026-09-17):
#     adb shell uname -r   ->   5.4.302-moto-gc8bc4b74db62
# The "-gc8bc4b74db62" part is produced by scripts/setlocalversion: 12 hex
# characters of the kernel git commit the ROM was built from
# (full sha c8bc4b74db62d4d4b24c575046f140f4e6732898).
#
# Ask the device again whenever the ROM is updated and put the result here:
#      adb shell uname -r
# or let the build script do it (it also pins the kernel source to that commit):
#      STOCK_RELEASE="$(adb shell uname -r)" ./build-nethunter-kernel.sh config
#
# CONFIG_LOCALVERSION_AUTO appends "-g<git hash>" of whatever checkout you
# build from, which would add a *second* hash, so it is disabled and the exact
# string is pinned in CONFIG_LOCALVERSION instead.
CONFIG_LOCALVERSION="-moto-gc8bc4b74db62"
# CONFIG_LOCALVERSION_AUTO is not set

# Only if you ALSO rebuild every module and repack vendor_boot.img yourself:
#CONFIG_LOCALVERSION="-NetHunter-milanf"


# =============================================================================
# 2. USB gadget: HID / BadUSB / USB Arsenal
# =============================================================================
# Already enabled by stock LineageOS 23.2 (do NOT add these again - there is no
# CONFIG_USB_CONFIGFS_HID symbol, the configfs HID function is ..._F_HID):
#   CONFIG_USB_GADGET=y            CONFIG_USB_CONFIGFS=y
#   CONFIG_USB_CONFIGFS_F_HID=y    CONFIG_USB_F_HID=y
#   CONFIG_USB_F_FS=y              CONFIG_USB_CONFIGFS_F_FS=y
#   CONFIG_USB_CONFIGFS_ACM=y      CONFIG_USB_CONFIGFS_NCM=y
#   CONFIG_USB_CONFIGFS_MASS_STORAGE=y
#   CONFIG_USB_CONFIGFS_F_MIDI=y   CONFIG_USB_CONFIGFS_F_DIAG=y
#   CONFIG_USB_CONFIGFS_F_QDSS=y   CONFIG_USB_CONFIGFS_F_GSI=y
#   CONFIG_USB_CONFIGFS_F_CCID=y   CONFIG_USB_CONFIGFS_F_ACC=y
#   CONFIG_USB_CONFIGFS_F_AUDIO_SRC=y
#   CONFIG_INPUT_UINPUT=y          CONFIG_HIDRAW=y
# /dev/hidg0..2 therefore already works on the stock kernel.
#
# NOTE: the legacy "precomposed" gadget menu (CONFIG_USB_G_HID, USB_G_SERIAL,
# USB_ZERO, ...) is NOT built in this kernel - those symbols do not exist in the
# running config - so configfs is the only way to build gadgets here.

# Extra configfs functions used by NetHunter (USB Arsenal / tethering)
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y


# =============================================================================
# 3. USB host side: serial adapters, WWAN dongles, USB sniffing
# =============================================================================
CONFIG_USB_ACM=y                # CDC-ACM host: Arduino, ChipWhisperer, GPS
CONFIG_USB_WDM=y                # required by QMI / Option drivers
CONFIG_USB_MON=y                # usbmon -> capture USB traffic in Wireshark
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_QMI_WWAN=y       # 4G/LTE sticks
CONFIG_USB_NET_CDC_MBIM=y

CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_WWAN=y
CONFIG_USB_SERIAL_OPTION=y
CONFIG_USB_SERIAL_QUALCOMM=y
CONFIG_USB_SERIAL_PL2303=y      # Prolific PL2303
CONFIG_USB_SERIAL_CP210X=y      # Silabs CP210x
CONFIG_USB_SERIAL_FTDI_SIO=y    # FTDI (most CAN/USB-serial adapters)
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_ARK3116=y
CONFIG_USB_SERIAL_MCT_U232=y
CONFIG_USB_SERIAL_BELKIN=y
CONFIG_USB_SERIAL_TI=y
CONFIG_USB_SERIAL_CYPRESS_M8=y
CONFIG_USB_SERIAL_F81232=y
CONFIG_USB_SERIAL_KEYSPAN=y
# Verified against this kernel tree (drivers/usb/serial/Kconfig): the following
# three do NOT exist here, they were removed upstream, so they are not listed:
#   CONFIG_USB_SERIAL_SIERRA      (WWAN is covered by USB_SERIAL_WWAN +
#                                  USB_SERIAL_OPTION + USB_NET_QMI_WWAN above)
#   CONFIG_USB_SERIAL_KL5KUSB101  (ancient, gone)
#   CONFIG_USB_SERIAL_IO_TI       (the TI driver is CONFIG_USB_SERIAL_TI above)


# =============================================================================
# 4. External USB Wi-Fi adapters (monitor mode / injection)
# =============================================================================
# The built-in WCN6750 (CONFIG_QCA_CLD_WLAN=m) cannot monitor or inject, so an
# external adapter is mandatory. These in-tree cfg80211/mac80211 drivers are
# built-in (=y) so nothing has to be shipped beside the ROM's vendor modules.
#
# Deliberately NOT enabled here (each one changes a struct layout in
# include/net/cfg80211.h or include/net/mac80211.h, which changes symbol CRCs
# and stops the stock vendor WLAN module from loading):
#   CONFIG_CFG80211_WEXT, CONFIG_MAC80211_MESH, CONFIG_WIRELESS_WDS
# Enable them only if you also rebuild and flash every vendor module.

# Ralink RT2x00 USB - RT5370/RT5572/RT3070: Panda PAU05/PAU06/PAU09,
# Alfa AWUS036NH, most "wifi pineapple compatible" dongles
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y

# Atheros AR9271 / AR7010 - Alfa AWUS036NHA, TP-Link TL-WN722N v1
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=y

# Realtek
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8187=y                # RTL8187/8187B - classic Alfa AWUS036H
CONFIG_RTL8192CU=y
CONFIG_RTL8XXXU=y               # RTL8188/8192/8723/8821/8822 USB
CONFIG_RTL8XXXU_UNTESTED=y
# CONFIG_R8188EU is not set
#   ^ the staging 8188EU driver CANNOT be built-in - its Kconfig says
#     "depends on m" - and this build ships no modules (the ROM's modules in
#     vendor_boot must stay untouched), so the module would never be loaded.
#     RTL8188EU/8192EU/8723BU class dongles are covered by rtl8xxxu above.
#     If you really want r8188eu, build modules and repack vendor_boot.img.

# MediaTek MT76x0U / MT76x2U - Alfa AWUS036ACHM, Archer T2U Plus, T3U
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT76_CORE=y
CONFIG_MT76_USB=y
CONFIG_MT76x0U=y
CONFIG_MT76x2U=y

# NOTE: adapters on RTL8812AU / RTL8821AU / RTL8814AU (Alfa AWUS036ACH,
# AWUS036ACS, ...) need the out-of-tree "88XXAU" driver. It is not in the
# kernel: build it as an external module against this kernel and ship it with
# your own vendor_boot, or use one of the in-tree chipsets above.


# =============================================================================
# 5. Netfilter / iptables extras (MITM, tethering, wardriving)
# =============================================================================
# ipset (used by many Kali MITM and blocking scripts)
CONFIG_IP_SET=y
CONFIG_IP_SET_MAX=256
CONFIG_IP_SET_BITMAP_IP=y
CONFIG_IP_SET_BITMAP_IPMAC=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_IPMARK=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_IPPORTIP=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_IP_SET_HASH_MAC=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_NETIFACE=y
CONFIG_IP_SET_HASH_NETNET=y
CONFIG_IP_SET_HASH_NETPORT=y
CONFIG_IP_SET_HASH_NETPORTNET=y
CONFIG_IP_SET_LIST_SET=y

# xtables matches missing from the stock config
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=y
# CONFIG_NETFILTER_XT_MATCH_CONNLABEL is not set   # selects NF_CONNTRACK_LABELS
CONFIG_NETFILTER_XT_MATCH_CPU=y
CONFIG_NETFILTER_XT_MATCH_DCCP=y
CONFIG_NETFILTER_XT_MATCH_DEVGROUP=y
CONFIG_NETFILTER_XT_MATCH_IPCOMP=y
CONFIG_NETFILTER_XT_MATCH_OSF=y
CONFIG_NETFILTER_XT_MATCH_RATEEST=y
# CONFIG_NETFILTER_XT_MATCH_REALM is not set      # selects IP_ROUTE_CLASSID
CONFIG_NETFILTER_XT_MATCH_SCTP=y
CONFIG_NETFILTER_XT_MATCH_CLUSTER=y

# xtables targets missing from the stock config
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_NETFILTER_XT_TARGET_AUDIT=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NETFILTER_XT_TARGET_HMARK=y
CONFIG_NETFILTER_XT_TARGET_RATEEST=y
CONFIG_NETFILTER_XT_TARGET_TCPOPTSTRIP=y

# Conntrack helper (SIP/RTP - VoIP traversal). Safe.
CONFIG_NF_CONNTRACK_SIP=y

# CONFIG_BRIDGE_NETFILTER is deliberately NOT enabled.
# Measured on this device: enabling it changes symbol CRCs (device_register
# 0xbae8d216 -> 0xaa3baaa0, and with it the other 72 symbols the ROM's modules
# import), so the prebuilt vendor modules in vendor_boot.img (Wi-Fi, camera,
# charger) refuse to load with "disagrees about version of symbol". It also
# auto-selects CONFIG_NETFILTER_FAMILY_BRIDGE. Bridge-level netfilter is not
# worth breaking those modules for - use the normal iptables/ipset path above.
#CONFIG_BRIDGE_NETFILTER=y

# Qualcomm's own NAT helper modules (ipt_NATTYPE / ipt_TRIGGER) are deliberately
# NOT enabled: they only compile cleanly in Qualcomm's upstream configuration -
# with this config ipt_TRIGGER.c leaves several variables unused and the kernel
# builds with -Werror (CONFIG_CC_WERROR=y), so the build fails with
#   net/ipv4/netfilter/ipt_TRIGGER.c:288:31: error: unused variable 'dst_tcp_port'
# The standard netfilter NAT/masquerade support above is enough for tethering.
#CONFIG_IP_NF_TARGET_NATTYPE_MODULE=y
#CONFIG_IP_NF_TARGET_TRIGGER_MODULE=y


# =============================================================================
# 6. CAN bus - DISABLED, it breaks the ROM's prebuilt module ABI
# =============================================================================
# Measured on this device: enabling CAN alone changes symbol CRCs in completely
# unrelated translation units (device_register 0xbae8d216 -> 0xd7721f1f,
# __alloc_skb 0x64ae7464 -> 0xf5f9a425, wake_up_process 0x75716fd5 -> 0x83970e11,
# crypto_register_alg 0x0e3e1591 -> 0x76114555).
#
# Why: include/net/net_namespace.h wraps a member of `struct net` in
#   #if IS_ENABLED(CONFIG_CAN)
# and genksyms derives every exported symbol's CRC from the type table of its
# translation unit. Changing one struct in a widely included header therefore
# shifts the CRCs of unrelated symbols, and the ROM's prebuilt vendor modules
# in vendor_boot.img (Wi-Fi, camera, charger, audio) are then rejected with
# "disagrees about version of symbol".
#
# Re-enable only together with a full module rebuild + flash of every module.
#CONFIG_CAN=y
#CONFIG_CAN_RAW=y
#CONFIG_CAN_BCM=y
#CONFIG_CAN_GW=y
#CONFIG_CAN_DEV=y
#CONFIG_CAN_CALC_BITTIMING=y
#CONFIG_CAN_VCAN=y                # virtual CAN interface
#CONFIG_CAN_VXCAN=y               # virtual CAN tunnel
#CONFIG_CAN_SLCAN=y               # LAWICEL/serial CAN adapters
#CONFIG_CAN_EMS_USB=y
#CONFIG_CAN_ESD_USB2=y
#CONFIG_CAN_GS_USB=y
#CONFIG_CAN_KVASER_USB=y
#CONFIG_CAN_MCBA_USB=y
#CONFIG_CAN_PEAK_USB=y
#CONFIG_CAN_UCAN=y


# =============================================================================
# 7. NFS client + server (remote mounts / pentest over network)
# =============================================================================
# LOCKD, SUNRPC, NFS_COMMON, GRACE_PERIOD, NFS_ACL_SUPPORT are "select"ed
# automatically by these options - they must NOT be listed here.
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V3_ACL=y
CONFIG_NFS_V4=y
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
CONFIG_NFSD=y
CONFIG_NFSD_V3=y
CONFIG_NFSD_V3_ACL=y
CONFIG_NFSD_V4=y
CONFIG_NFSD_V4_SECURITY_LABEL=y
CONFIG_EXPORTFS_BLOCK_OPS=y


# =============================================================================
# 8. Bluetooth USB dongles (built-in Qualcomm BT stays untouched)
# =============================================================================
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBCM203X=y
CONFIG_BT_HCIBPA10X=y
CONFIG_BT_HCIUART_3WIRE=y


# =============================================================================
# 9. Cellular dongles / VPN plumbing
# =============================================================================
CONFIG_PPP_ASYNC=y
CONFIG_PPP_SYNC_TTY=y


# =============================================================================
# 10. Optional extras - enable deliberately, they have trade-offs
# =============================================================================
# nftables (Android 16 netd can use it; larger change, test carefully)
#CONFIG_NF_TABLES=y
#CONFIG_NFT_NAT=y
#CONFIG_NFT_COMPAT=y
#
# /dev/mem - some forensics tools want it, but it weakens kernel security
#CONFIG_DEVMEM=y
#
# Legacy wireless extensions - aircrack-ng/iwconfig era tools. BREAKS the
# stock vendor WLAN module (wireless_dev layout / CRC change). Opt-in only.
#CONFIG_CFG80211_WEXT=y
#
# 802.11s mesh. Same CRC caveat as above.
#CONFIG_MAC80211_MESH=y
#
# Kernel debugging (huge, slow builds - only for troubleshooting)
#CONFIG_DEBUG_FS=y
#CONFIG_KALLSYMS_ALL is already enabled in stock
#CONFIG_CFI_PERMISSIVE=y         # temporarily, if a module is rejected by CFI
