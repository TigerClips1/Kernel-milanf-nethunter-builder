# milanf_nethunter.config
#
# NetHunter feature fragment for the Motorola milanf QGKI 5.4.302 kernel.
# Merged on top of the base config in scripts/05_configure.sh, alongside
# milanf_kernelsu.config. Sections are numbered and self-contained; each one
# documents why its options are needed and any ABI/build gotchas that go
# with them.

# =============================================================================
# 1. General
# =============================================================================
# NetHunter tools such as Metasploit and PostgreSQL rely on SysV shared memory
# and semaphores. Those features change the module ABI, so the Android vendor
# and recovery modules must be rebuilt and packaged with this kernel.
CONFIG_SYSVIPC=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_DEFAULT_HOSTNAME="kali"
# The kernel release string is set in section 2 below. Keep it here rather than
# using CONFIG_LOCALVERSION_AUTO because the ROM's module vermagic must stay
# explicit and reproducible.

# =============================================================================
# 2. Kernel release string - CRITICAL, read this
# =============================================================================
# The stock ROM vendor modules carry the vermagic:
#     5.4.302-moto-gc8bc4b74db62 SMP preempt mod_unload modversions aarch64
# Because CONFIG_MODVERSIONS=y, the kernel will reject any vendor module whose
# vermagic does not match exactly. This means the custom build must rebuild and
# package the full vendor module set, not only the external Wi‑Fi drivers.
#
# Measured on a LineageOS 23.2 device (built 2026-09-17):
#     adb shell uname -r   ->   5.4.302-moto-gc8bc4b74db62
# The "-gc8bc4b74db62" suffix comes from the ROM's setlocalversion output: a
# 12-character kernel git hash (full sha
# c8bc4b74db62d4d4b24c575046f140f4e6732898).
#
# The stock release above is kept only as a reference. This NetHunter build uses
# a distinct local version string instead:
#     adb shell uname -r
# The packaging step replaces the initial vendor_boot module set with the full
# rebuilt module tree and the ROM's ordered modules.load list. Flash the rebuilt
# image together with this kernel; the stock vendor ABI is intentionally not
# preserved.
# CONFIG_LOCALVERSION_AUTO appends the checkout hash when enabled, so leave it
# disabled to keep this custom suffix stable and predictable.
CONFIG_LOCALVERSION="-nethunter-milanf"
# CONFIG_LOCALVERSION_AUTO is not set

# =============================================================================
# 3. Network: mac80211
# =============================================================================
# Kali legacy wireless tools and EvilTwin need WEXT/mesh. The module ABI changes
# are handled by rebuilding and packaging all Android/recovery vendor modules.
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211_MESH=y

# =============================================================================
# 4. Network: socket diagnostics
# =============================================================================
# docs (CAN chapter, "Networking options"): "NETLINK: socket monitoring
# interface" and "Virtual Socket protocol".
CONFIG_NETLINK_DIAG=y
CONFIG_VSOCKETS=y

# =============================================================================
# 5. Bluetooth: external adapters and USB dongles
# =============================================================================
# BT Arsenal drives external adapters: Sena UD100 (CSR BC04), TP-Link UB500
# (RTL8761BU), generic CSR 4.0.  The USB ones are covered by BT_HCIBTUSB
# (+_RTL) which the ROM already enables; these add the remaining transports.
CONFIG_BT_HCIBFUSB=y                  # HCI BlueFRITZ! USB
CONFIG_BT_HCIVHCI=y                   # virtual HCI device (btvirt/testing)
CONFIG_BT_HCIUART_INTEL=y             # Intel UART controllers
CONFIG_BT_HCIUART_ATH3K=y             # Atheros UART firmware download
CONFIG_BT_HCIUART_MRVL=y              # Marvell UART
# NOT possible: CONFIG_BT_HCIUART_RTL (the docs' "Realtek protocol support")
#   depends on ACPI + BT_HCIUART_SERDEV + GPIOLIB - arm64 Android has no ACPI.
#   Realtek USB dongles (TP-Link UB500) are covered by BT_HCIBTUSB_RTL=y below.
CONFIG_BT_ATH3K=y                     # Atheros USB firmware download
CONFIG_BT_MRVL=y                      # Marvell Bluetooth (incl. dongles)
CONFIG_BT_BNEP=y                      # Bluetooth PAN/bnep (blueman, pan attacks)
# Built-in Qualcomm BT stays untouched; these cover USB Bluetooth dongles.
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBCM203X=y
CONFIG_BT_HCIBPA10X=y
CONFIG_BT_HCIUART_3WIRE=y

# =============================================================================
# 6. Wi-Fi: external USB adapters (monitor mode / injection)
# =============================================================================
# The built-in WCN6750 (CONFIG_QCA_CLD_WLAN=m) cannot monitor or inject, so an
# external adapter is mandatory. These in-tree cfg80211/mac80211 drivers are
# built-in (=y) so nothing has to be shipped beside the ROM's vendor modules.
#
# WEXT and mesh are enabled above (section 3) for EvilTwin/legacy tooling. All
# matching vendor and recovery modules are rebuilt and packaged with this
# custom ABI.
#
# The docs' "Wifi injection = Yes" means: custom kernel + a supported external
# adapter.  The list below covers every documented chipset still missing from
# the ROM config.
# (NOTE: the *internal* qcacld-3.0 driver in this Motorola tree has no
#  gEnableMonitorMode plumbing, so built-in monitor/injection would need a
#  driver patch - external adapters are the supported path.)

# Ralink RT2x00 USB - RT5370/RT5572/RT3070: Panda PAU05/PAU06/PAU09,
# Alfa AWUS036NH, most "wifi pineapple compatible" dongles
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_RT2500USB=y                    # Ralink rt2500
CONFIG_RT73USB=y                      # Ralink rt73

# Atheros AR9271 / AR7010 - Alfa AWUS036NHA, TP-Link TL-WN722N v1
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=y
CONFIG_CARL9170=y                     # Atheros AR9170 (Linux community)
CONFIG_ATH6KL=y
CONFIG_ATH6KL_USB=y                   # Atheros ath6kl USB

# Realtek
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8187=y                # RTL8187/8187B - classic Alfa AWUS036H
CONFIG_RTL8192CU=y
CONFIG_RTL8XXXU=y               # RTL8188/8192/8723/8821/8822 USB
CONFIG_RTL8XXXU_UNTESTED=y
# CONFIG_R8188EU is not set
#   ^ the staging 8188EU driver depends on module support. Its separately built
#     module is shipped through the KernelSU module; rtl8xxxu also covers common
#     RTL8188/8192/8723 USB chipsets.

# MediaTek MT76x0U / MT76x2U - Alfa AWUS036ACHM, Archer T2U Plus, T3U
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT76_CORE=y
CONFIG_MT76_USB=y
CONFIG_MT76x0U=y
CONFIG_MT76x2U=y
CONFIG_MT7601U=y                      # MediaTek MT7601U (very common stick)

# NOTE: adapters on RTL8812AU / RTL8821AU / RTL8814AU (Alfa AWUS036ACH,
# AWUS036ACS, ...) need the out-of-tree "88XXAU" driver. It is not in the
# kernel: build it as an external module against this kernel and ship it with
# your own vendor_boot, or use one of the in-tree chipsets above.

# ZyDAS / other legacy chipsets
CONFIG_WLAN_VENDOR_ZYDAS=y
CONFIG_USB_ZD1201=y
CONFIG_ZD1211RW=y                     # ZyDAS ZD1211/1211B
CONFIG_USB_NET_RNDIS_WLAN=y           # "Wireless RNDIS USB support"

# =============================================================================
# 7. SDR (RTL-SDR, HackRF, Airspy)
# =============================================================================
# docs: Media support -> "Digital TV support" + "Software defined radio
# support", then Media USB adapters AirSpy / HackRF / Mirics MSi2500.
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=y
CONFIG_MEDIA_SDR_SUPPORT=y
CONFIG_DVB_CORE=y
# RC_CORE is a dependency of the (older) dvb-usb v1 core.
CONFIG_RC_CORE=y
CONFIG_DVB_USB=y
CONFIG_DVB_USB_V2=y
CONFIG_USB_AIRSPY=y
CONFIG_USB_HACKRF=y
CONFIG_USB_MSI2500=y
# Follow Kali's documented manual frontend selection; the explicitly selected
# RTL-SDR frontends/tuners below provide the intended USB SDR support.
# CONFIG_MEDIA_SUBDRV_AUTOSELECT is not set
CONFIG_DVB_RTL2830=y
CONFIG_DVB_RTL2832=y
CONFIG_DVB_RTL2832_SDR=y              # RTL-SDR (the documented dongle)
CONFIG_DVB_SI2168=y
CONFIG_DVB_ZD1301_DEMOD=y
# The RTL2832U *USB bridge* - without this there is no /dev/dvb or /dev/swradio
# device and neither rtl_test nor RF Analyzer can see the stick.
CONFIG_DVB_USB_RTL28XXU=y
# RTL-SDR tuners: the R820T/R820T2 is in practically every RTL2832U stick sold
# as an "RTL-SDR", the others cover the older/rarer dongles.
CONFIG_MEDIA_TUNER_R820T=y
CONFIG_MEDIA_TUNER_E4000=y
CONFIG_MEDIA_TUNER_FC0012=y
CONFIG_MEDIA_TUNER_FC0013=y
CONFIG_MEDIA_TUNER_FC2580=y
CONFIG_MEDIA_TUNER_MT2060=y

# =============================================================================
# 8. USB gadget: HID / BadUSB / USB Arsenal
# =============================================================================
# Already enabled by stock LineageOS 23.2 (do NOT add these again - there is no
# CONFIG_USB_CONFIGFS_HID symbol, the configfs HID function is ..._F_HID):
#   CONFIG_USB_GADGET=y            CONFIG_USB_CONFIGFS=y
#   CONFIG_USB_CONFIGFS_F_HID=y    CONFIG_USB_F_HID=y
#   CONFIG_USB_F_FS=y              CONFIG_USB_CONFIGFS_F_FS=y
#   CONFIG_USB_CONFIGFS_ACM=y      CONFIG_USB_CONFIGFS_NCM=y
#   CONFIG_USB_CONFIGFS_MASS_STORAGE=y
#   CONFIG_USB_CONFIGFS_F_MIDI=y   CONFIG_USB_CONFIGFS_F_DIAG=y
#   CONFIG_USB_CONFIGFS_F_QDSS=y   CONFIG_USB_CONFIGFS_F_GSI=y
#   CONFIG_USB_CONFIGFS_F_CCID=y   CONFIG_USB_CONFIGFS_F_ACC=y
#   CONFIG_USB_CONFIGFS_F_AUDIO_SRC=y
#   CONFIG_INPUT_UINPUT=y          CONFIG_HIDRAW=y
# /dev/hidg0..2 therefore already works on the stock kernel.
#
# NOTE: the legacy "precomposed" gadget menu (CONFIG_USB_G_HID, USB_G_SERIAL,
# USB_ZERO, ...) is NOT built in this kernel - those symbols do not exist in the
# running config - so configfs is the only way to build gadgets here.

# Extra configfs functions used by NetHunter (USB Arsenal / tethering)
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y

# =============================================================================
# 9. NetHunter extras and USB gadget parity with the official docs
# =============================================================================
# These USB functions and input options are already enabled by the supplied
# milanf device config. Keep the actual NetHunter additions in section 8 above.
CONFIG_USB_CONFIGFS_OBEX=y            # CDC OBEX
CONFIG_USB_CONFIGFS_EEM=y             # Ethernet Emulation Model
CONFIG_USB_SERIAL_CONSOLE=y           # USB serial console

# =============================================================================
# 9. USB host side: serial adapters, WWAN dongles, USB sniffing
# =============================================================================
CONFIG_USB_ACM=y                # CDC-ACM host: Arduino, ChipWhisperer, GPS
CONFIG_USB_WDM=y                # required by QMI / Option drivers
CONFIG_USB_MON=y                # usbmon -> capture USB traffic in Wireshark
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_QMI_WWAN=y       # 4G/LTE sticks
CONFIG_USB_NET_CDC_MBIM=y

CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_WWAN=y
CONFIG_USB_SERIAL_OPTION=y
CONFIG_USB_SERIAL_QUALCOMM=y
CONFIG_USB_SERIAL_PL2303=y      # Prolific PL2303
CONFIG_USB_SERIAL_CP210X=y      # Silabs CP210x
CONFIG_USB_SERIAL_FTDI_SIO=y    # FTDI (most CAN/USB-serial adapters)
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_ARK3116=y
CONFIG_USB_SERIAL_MCT_U232=y
CONFIG_USB_SERIAL_BELKIN=y
CONFIG_USB_SERIAL_TI=y
CONFIG_USB_SERIAL_CYPRESS_M8=y
CONFIG_USB_SERIAL_F81232=y
CONFIG_USB_SERIAL_KEYSPAN=y
# Verified against this kernel tree (drivers/usb/serial/Kconfig): the following
# three do NOT exist here, they were removed upstream, so they are not listed:
#   CONFIG_USB_SERIAL_SIERRA      (WWAN is covered by USB_SERIAL_WWAN +
#                                  USB_SERIAL_OPTION + USB_NET_QMI_WWAN above)
#   CONFIG_USB_SERIAL_KL5KUSB101  (ancient, gone)
#   CONFIG_USB_SERIAL_IO_TI       (the TI driver is CONFIG_USB_SERIAL_TI above)

# =============================================================================
# 10. CAN: CARsenal core, protocols, and adapters
# =============================================================================
CONFIG_CAN=m
CONFIG_CAN_RAW=m
CONFIG_CAN_BCM=m
CONFIG_CAN_GW=m
CONFIG_CAN_VCAN=m
CONFIG_CAN_SLCAN=m
CONFIG_CAN_DEV=m
CONFIG_CAN_CALC_BITTIMING=y
CONFIG_hlcan=m
CONFIG_CAN_ISOTP=m
CONFIG_NET_EMATCH_CANID=m
# The docs' CAN_LEDS option depends on CONFIG_BROKEN in this tree; the netdev
# trigger provides the documented LED activity behavior instead.
CONFIG_LEDS_TRIGGER_NETDEV=y
CONFIG_CAN_8DEV_USB=m
CONFIG_CAN_EMS_USB=m
CONFIG_CAN_ESD_USB2=m
CONFIG_CAN_GS_USB=m
CONFIG_CAN_KVASER_USB=m
CONFIG_CAN_PEAK_USB=m
CONFIG_CAN_MCBA_USB=m
CONFIG_CAN_UCAN=m
CONFIG_CAN_GRCAN=m
CONFIG_CAN_XILINXCAN=m
CONFIG_CAN_C_CAN=m
CONFIG_CAN_C_CAN_PLATFORM=m
CONFIG_CAN_CC770=m
CONFIG_CAN_CC770_PLATFORM=m
CONFIG_CAN_IFI_CANFD=m
CONFIG_CAN_SJA1000=m
CONFIG_CAN_SJA1000_PLATFORM=m
CONFIG_CAN_M_CAN=m
CONFIG_CAN_M_CAN_PLATFORM=m
CONFIG_CAN_SOFTING=m
CONFIG_CAN_HI311X=m
CONFIG_CAN_MCP251X=m

# =============================================================================
# 11. Netfilter / iptables extras (MITM, tethering, wardriving)
# =============================================================================
# ipset (used by many Kali MITM and blocking scripts)
CONFIG_IP_SET=y
CONFIG_IP_SET_MAX=256
CONFIG_IP_SET_BITMAP_IP=y
CONFIG_IP_SET_BITMAP_IPMAC=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_IPMARK=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_IPPORTIP=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_IP_SET_HASH_MAC=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_NETIFACE=y
CONFIG_IP_SET_HASH_NETNET=y
CONFIG_IP_SET_HASH_NETPORT=y
CONFIG_IP_SET_HASH_NETPORTNET=y
CONFIG_IP_SET_LIST_SET=y

# xtables matches missing from the stock config
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=y
# CONFIG_NETFILTER_XT_MATCH_CONNLABEL is not set   # selects NF_CONNTRACK_LABELS
CONFIG_NETFILTER_XT_MATCH_CPU=y
CONFIG_NETFILTER_XT_MATCH_DCCP=y
CONFIG_NETFILTER_XT_MATCH_DEVGROUP=y
CONFIG_NETFILTER_XT_MATCH_IPCOMP=y
CONFIG_NETFILTER_XT_MATCH_OSF=y
CONFIG_NETFILTER_XT_MATCH_RATEEST=y
# CONFIG_NETFILTER_XT_MATCH_REALM is not set      # selects IP_ROUTE_CLASSID
CONFIG_NETFILTER_XT_MATCH_SCTP=y
CONFIG_NETFILTER_XT_MATCH_CLUSTER=y

# xtables targets missing from the stock config
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_NETFILTER_XT_TARGET_AUDIT=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NETFILTER_XT_TARGET_HMARK=y
CONFIG_NETFILTER_XT_TARGET_RATEEST=y
CONFIG_NETFILTER_XT_TARGET_TCPOPTSTRIP=y

# Conntrack helper (SIP/RTP - VoIP traversal). Safe.
CONFIG_NF_CONNTRACK_SIP=y

# This build ships a custom vendor_boot.img with rebuilt vendor modules, so the
# earlier vendor-ABI warning no longer applies. Bridge netfilter and the
# Qualcomm NAT-helper modules are enabled here to keep feature parity with the
# upstream NetHunter/Tethering expectations for this device.
CONFIG_BRIDGE_NETFILTER=y
CONFIG_IP_NF_TARGET_NATTYPE_MODULE=y
CONFIG_IP_NF_TARGET_TRIGGER_MODULE=y

# =============================================================================
# 12. NFS client + server (remote mounts / pentest over network)
# =============================================================================
# LOCKD, SUNRPC, NFS_COMMON, GRACE_PERIOD, NFS_ACL_SUPPORT are "select"ed
# automatically by these options - they must NOT be listed here.
CONFIG_NFS_FS=y
CONFIG_NFS_V2=y
CONFIG_NFS_V3=y
CONFIG_NFS_V3_ACL=y
CONFIG_NFS_V4=y
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
CONFIG_NFSD=y
CONFIG_NFSD_V3=y
CONFIG_NFSD_V3_ACL=y
CONFIG_NFSD_V4=y
CONFIG_NFSD_V4_SECURITY_LABEL=y
CONFIG_EXPORTFS_BLOCK_OPS=y

# =============================================================================
# 13. Cellular dongles / VPN plumbing
# =============================================================================
CONFIG_PPP_ASYNC=y
CONFIG_PPP_SYNC_TTY=y
